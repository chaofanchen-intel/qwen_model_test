+        // sibling FullyConnectedCompressed (e.g. q/k/v/z or gate/up sharing a layernorm
+        // output) when the config is identical, instead of inserting a duplicate.
+        auto dyn_quan = find_reusable_dq(m_fc->input_value(0), config);
+        if (!dyn_quan) {
+            dyn_quan = std::make_shared<ov::op::internal::DynamicQuantize>(m_fc->input_value(0), config);
+        }
