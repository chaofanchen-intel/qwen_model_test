--- a/src/plugins/intel_gpu/src/plugin/transformations/dynamic_quantize_fully_connected.cpp
+++ b/src/plugins/intel_gpu/src/plugin/transformations/dynamic_quantize_fully_connected.cpp
@@ -17,6 +17,44 @@
 
 namespace ov::intel_gpu {
 
+namespace {
+// TTFT-opt (opt-3): two FullyConnectedCompressed that consume the SAME activation
+// (e.g. Qwen3.5 linear_attn in_proj_qkv/a/b/z share the input_layernorm output, and
+// mlp gate_proj/up_proj share the post_attention_layernorm output) each get their own
+// DynamicQuantize inserted below. When their quantization configs are identical the
+// activation is re-quantized 2-4x per layer for nothing. The generic SharedOpOptimization
+// cannot dedup them because DynamicQuantize has no visit_attributes (its attr-map is empty,
+// so it would merge even config-mismatched nodes). We dedup explicitly here, reusing an
+// existing DynamicQuantize on the same activation only when every attribute that affects
+// the produced values/output-layout matches exactly -> numerically identical, never merges
+// a config mismatch.
+bool dq_attrs_equal(const ov::op::internal::DynamicQuantize::Attributes& a,
+                    const ov::op::internal::DynamicQuantize::Attributes& b) {
+    return a.quantization_type == b.quantization_type &&
+           a.quantization_dt == b.quantization_dt &&
+           a.scale_dt == b.scale_dt &&
+           a.zp_dt == b.zp_dt &&
+           a.precomputed_reduction == b.precomputed_reduction &&
+           a.precomputed_reduction_dt == b.precomputed_reduction_dt &&
+           a.output_storage_type == b.output_storage_type &&
+           a.group_sizes == b.group_sizes;
+}
+
+// Search the consumers of `act` for an already-inserted DynamicQuantize with an equal
+// config. scales_zp_output_order / group_sizes length depend only on the activation rank,
+// which is identical for consumers of the same Output, so dq_attrs_equal is sufficient.
+std::shared_ptr<ov::op::internal::DynamicQuantize>
+find_reusable_dq(const ov::Output<ov::Node>& act,
+                 const ov::op::internal::DynamicQuantize::Attributes& cfg) {
+    for (const auto& ti : act.get_target_inputs()) {
+        auto cand = ov::as_type_ptr<ov::op::internal::DynamicQuantize>(ti.get_node()->shared_from_this());
+        if (cand && dq_attrs_equal(cand->get_attrs(), cfg))
+            return cand;
+    }
+    return nullptr;
+}
+}  // namespace
