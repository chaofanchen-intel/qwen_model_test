@@ -1047,6 +1047,22 @@ void layout_optimizer::set_onednn_dyn_conv_preferred_format(convolution_node& no
     auto input_channels = get_convolution_channel_count(node, input_layout, true);
     auto output_channels = get_convolution_channel_count(node, output_layout, false);
 
+    // TTFT-opt: depthwise convolutions (groups == in_ch == out_ch, e.g. the
+    // causal conv1d inside Qwen3.5 Gated-DeltaNet SSM layers) gain nothing from
+    // a blocked fsv16 layout — each output channel reads exactly one input
+    // channel, so there is zero channel-block reuse in the conv kernel. The only
+    // effect of fsv16 here is a bfyx->blocked reorder before the conv and a
+    // blocked->bfyx reorder after; on the SSM conv1d (kernel=4, trivial compute)
+    // those two reorders dominate the layer's prefill cost (~785us/layer x18 on
+    // Qwen3.5-2B). Keep planar format so no reorder is inserted around the conv;
+    // the dynamic OCL conv impl supports bfyx natively.
+    if (input_channels > 0 && static_cast<uint32_t>(input_channels) == node.get_groups() &&
